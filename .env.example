# PostgreSQL connection string. Tables are created by scripts/init.sql.
DATABASE_URL=postgresql://user:password@localhost:5432/meucomboio

# Static token that authorizes POST /api/meucomboio/sync (used by the cron job).
# Generate one with: openssl rand -hex 32
MEUCOMBOIO_SYNC_TOKEN=

# Optional: OpenRouteService API key for walking/driving time to the station.
# Without it the app falls back to straight-line estimates.
MEUCOMBOIO_ORS_KEY=
